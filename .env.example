# Development only. Copy to .env and replace passwords before running.
DATABASE_URL="postgresql://cat:change-local-password@localhost:55432/cat_nusantara?schema=public"
POSTGRES_USER=cat
POSTGRES_PASSWORD=change-local-password
POSTGRES_DB=cat_nusantara
MINIO_ROOT_USER=catadmin
MINIO_ROOT_PASSWORD=change-minio-password

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-random-secret"
REDIS_URL="redis://127.0.0.1:6379"
