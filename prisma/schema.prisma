generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum QuestionCategory {
  TWK
  TIU
  TKP
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamSessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  passwordHash  String
  role          UserRole             @default(PARTICIPANT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      AuthSession[]
  resets        PasswordResetToken[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  examSessions  ExamSession[]

  @@index([role])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model MembershipPlan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  priceIdr      Int
  durationDays  Int
  quota         Int
  active        Boolean        @default(true)
  subscriptions Subscription[]

  @@map("membership_plans")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus
  startsAt  DateTime
  endsAt    DateTime
  quota     Int
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      MembershipPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  usage     UsageRecord[]

  @@index([userId, status, endsAt])
  @@map("subscriptions")
}

model UsageRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  reference      String
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, reference])
  @@map("usage_records")
}

model Question {
  id              String            @id @default(cuid())
  code            String            @unique
  category        QuestionCategory
  topic           String
  difficulty      String
  sourceReference String?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  versions        QuestionVersion[]

  @@index([category])
  @@map("questions")
}

model QuestionVersion {
  id               String               @id @default(cuid())
  questionId       String
  version          Int
  status           QuestionStatus       @default(DRAFT)
  prompt           String
  explanation      String?
  imagePath        String?
  imageAlt         String?
  isDemo           Boolean              @default(false)
  importBatchId    String?
  createdAt        DateTime             @default(now())
  question         Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  importBatch      QuestionImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  options          QuestionOption[]
  sessionQuestions SessionQuestion[]

  @@unique([questionId, version])
  @@index([status, isDemo])
  @@map("question_versions")
}

model TryoutEvent {
  id              String        @id @default(cuid())
  code            String        @unique
  title           String
  description     String?
  status          EventStatus   @default(DRAFT)
  isInternalDemo  Boolean       @default(false)
  durationMinutes Int           @default(100)
  twkCount        Int           @default(30)
  tiuCount        Int           @default(35)
  tkpCount        Int           @default(45)
  createdAt       DateTime      @default(now())
  sessions        ExamSession[]

  @@map("tryout_events")
}

model ExamSession {
  id          String            @id @default(cuid())
  userId      String
  eventId     String
  status      ExamSessionStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  event       TryoutEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  questions   SessionQuestion[]
  result      ExamResult?

  @@index([userId, status])
  @@index([eventId, status])
  @@map("exam_sessions")
}

model SessionQuestion {
  id                String          @id @default(cuid())
  sessionId         String
  questionVersionId String
  position          Int
  optionOrder       Json
  correctOption     String?
  optionWeights     Json?
  session           ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  answer            ExamAnswer?

  @@unique([sessionId, position])
  @@index([sessionId])
  @@map("session_questions")
}

model ExamAnswer {
  id                String          @id @default(cuid())
  sessionQuestionId String          @unique
  selectedOption    String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessionQuestion   SessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)

  @@map("exam_answers")
}

model ExamResult {
  id         String      @id @default(cuid())
  sessionId  String      @unique
  twkScore   Int
  tiuScore   Int
  tkpScore   Int
  totalScore Int
  createdAt  DateTime    @default(now())
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@map("exam_results")
}

model QuestionImportBatch {
  id          String            @id @default(cuid())
  code        String            @unique
  filename    String
  sourceLabel String
  rowCount    Int
  importedAt  DateTime          @default(now())
  versions    QuestionVersion[]

  @@map("question_import_batches")
}

model QuestionOption {
  id                String          @id @default(cuid())
  questionVersionId String
  label             String
  text              String
  isCorrect         Boolean?
  weight            Int?
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@unique([questionVersionId, label])
  @@map("question_options")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([target, createdAt])
  @@map("audit_logs")
}
