generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  ADMIN
}
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
enum QuestionCategory {
  TWK
  TIU
  TKP
}
enum QuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(PARTICIPANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
  resets       PasswordResetToken[]
  subscriptions Subscription[]
  auditLogs    AuditLog[]
  @@index([role])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model MembershipPlan {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  priceIdr     Int
  durationDays Int
  quota        Int
  active       Boolean @default(true)
  subscriptions Subscription[]
  @@map("membership_plans")
}

model Subscription {
  id        String @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus
  startsAt  DateTime
  endsAt    DateTime
  quota     Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  usage     UsageRecord[]
  @@index([userId, status, endsAt])
  @@map("subscriptions")
}

model UsageRecord {
  id             String @id @default(cuid())
  subscriptionId String
  reference      String
  createdAt      DateTime @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  @@unique([subscriptionId, reference])
  @@map("usage_records")
}

model Question {
  id        String @id @default(cuid())
  category  QuestionCategory
  createdAt DateTime @default(now())
  versions  QuestionVersion[]
  @@index([category])
  @@map("questions")
}

model QuestionVersion {
  id          String @id @default(cuid())
  questionId  String
  version     Int
  status      QuestionStatus @default(DRAFT)
  prompt      String
  explanation String?
  isDemo      Boolean @default(false)
  createdAt   DateTime @default(now())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  options     QuestionOption[]
  @@unique([questionId, version])
  @@index([status, isDemo])
  @@map("question_versions")
}

model QuestionOption {
  id                String @id @default(cuid())
  questionVersionId String
  label             String
  text              String
  isCorrect         Boolean?
  weight            Int?
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  @@unique([questionVersionId, label])
  @@map("question_options")
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([target, createdAt])
  @@map("audit_logs")
}
